{
  "name": "erp-monitoring",
  "version": "0.0.1",
  "private": true,
  "main": "electron/main.js",
  "productName": "ERP Monitoring",
  "scripts": {
    "dev": "vite",
    "electron": "electron .",
    "build": "vite build",
    "dist": "electron-builder --win --x64 --publish never",
    "start": "cd electron/go && go build -o erp-monitoring.exe ./cmd/tracker && cd ../../ && concurrently \"npm run dev\" \"npm run electron\"",
    "exe": "cd electron/go && go build -o erp-monitoring.exe ./cmd/tracker && cd ../../ && npm run build && npm run dist"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.11.2",
    "@tailwindcss/vite": "^4.1.18",
    "axios": "^1.13.2",
    "clsx": "^2.1.1",
    "electron-log": "^5.4.3",
    "electron-store": "^8.2.0",
    "lucide-react": "^0.562.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.11.0",
    "react-toastify": "^11.0.5",
    "recharts": "^2.15.4",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "electron": "^25.3.1",
    "electron-builder": "^24.6.0",
    "vite": "^7.2.4"
  },
  "build": {
    "appId": "com.erp.monitoring",
    "productName": "ERP Monitoring",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "electron/go/erp-monitoring.exe",
        "to": "go/erp-monitoring.exe"
      }
    ],
    "asarUnpack": [
      "go/erp-monitoring.exe"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "protocols": [
      {
        "name": "ERP Monitoring",
        "schemes": [
          "erpmonitoring"
        ]
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    },
    "asar": true,
    "forceCodeSigning": false
  }
}
